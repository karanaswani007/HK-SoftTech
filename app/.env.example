# Use Neon’s pooled connection string for the application runtime.
# Keep sslmode=require in both URLs.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DBNAME?sslmode=require"

# Use Neon’s direct (non-pooler) connection string for Prisma schema commands.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require"

ADMIN_PASSWORD="replace-with-a-long-unique-password"
