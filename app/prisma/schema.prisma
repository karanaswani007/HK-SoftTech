generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContactInquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum ProjectType {
  PROJECT
  PRODUCT
}

model ContactInquiry {
  id        String                @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String?
  service   String
  budget    String?
  message   String @db.Text
  status    ContactInquiryStatus @default(NEW)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Service {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String?
  shortDescription String?  @db.Text
  category         String?
  keyServices      Json?
  pageIntroduction String?  @db.Text
  pagePoints       Json?
  pageCta          String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
}

model Project {
  id          String      @id @default(cuid())
  title       String
  description String?     @db.Text
  category    String?
  status      String?
  type        ProjectType @default(PROJECT)
  imageUrl    String?     @db.Text
  projectUrl  String?     @db.Text
  sourceUrl   String?     @db.Text
  featured    Boolean     @default(false)
  published   Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SiteContent {
  id                    String   @id @default("default")
  tagline               String   @db.Text
  email                 String
  phone                 String
  location              String
  linkedin              String
  instagram             String
  heroBadge             String
  heroTitlePrefix       String
  heroTitleHighlight    String
  heroTitleSuffix       String
  heroDescription       String   @db.Text
  heroPrimaryCta        String
  heroSecondaryCta      String
  companyHeading        String
  companyDescription    String   @db.Text
  servicesEyebrow       String
  servicesTitle         String
  servicesDescription   String   @db.Text
  faqEyebrow            String
  faqTitle              String
  faqDescription        String   @db.Text
  ctaEyebrow            String
  ctaTitle              String
  ctaPrimaryLabel       String
  ctaSecondaryLabel     String
  updatedAt             DateTime @updatedAt
}
