generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContactInquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum ProjectType {
  PROJECT
  PRODUCT
}

model ContactInquiry {
  id        String                @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String?
  service   String
  budget    String?
  message   String @db.Text
  status    ContactInquiryStatus @default(NEW)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Service {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String?
  shortDescription String?  @db.Text
  category         String?
  keyServices      Json?
  pageIntroduction String?  @db.Text
  pagePoints       Json?
  pageCta          String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
}

model Project {
  id          String      @id @default(cuid())
  title       String
  description String?     @db.Text
  category    String?
  status      String?
  type        ProjectType @default(PROJECT)
  imageUrl    String?     @db.Text
  projectUrl  String?     @db.Text
  sourceUrl   String?     @db.Text
  featured    Boolean     @default(false)
  published   Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SiteContent {
  id                       String   @id @default("default")
  tagline                  String   @db.Text
  email                    String
  phone                    String
  location                 String
  linkedin                 String
  instagram                String
  socialLinks              Json?
  heroBadge                String
  heroTitlePrefix          String
  heroTitleHighlight       String
  heroTitleSuffix          String
  heroDescription          String   @db.Text
  heroPrimaryCta           String
  heroSecondaryCta         String
  companyHeading           String
  companyDescription       String   @db.Text
  servicesEyebrow          String
  servicesTitle            String
  servicesDescription      String   @db.Text
  faqEyebrow               String
  faqTitle                 String
  faqDescription           String   @db.Text
  ctaEyebrow               String
  ctaTitle                 String
  ctaPrimaryLabel          String
  ctaSecondaryLabel        String
  servicesPageEyebrow      String   @default("Services")
  servicesPageTitle        String   @default("A complete digital growth ecosystem")
  servicesPageDescription  String   @default("HK SoftTech supports businesses, students, freelancers, startups, and organizations with practical technology services designed around real requirements.") @db.Text
  portfolioPageEyebrow     String   @default("Our work")
  portfolioPageTitle       String   @default("Products and projects built to make an impact")
  portfolioPageDescription String   @default("Explore selected digital products, client work, and experiments from HK SoftTech.") @db.Text
  contactPageEyebrow       String   @default("Contact")
  contactPageTitle         String   @default("Tell us about your project")
  contactPageDescription   String   @default("Tell us what you are building, improving, or planning so we can guide the right next step.") @db.Text
  updatedAt                DateTime @updatedAt
}
